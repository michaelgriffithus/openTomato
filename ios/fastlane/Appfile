# Every Apple identifier comes from the environment (see docs/release.md).
# This repo is public: no team id, issuer id, key id, or Apple ID is ever
# written here as a fallback.
app_identifier(ENV.fetch("APP_IDENTIFIER", "com.griffith.made.opentomato"))
apple_id(ENV["FASTLANE_APPLE_ID"]) if ENV["FASTLANE_APPLE_ID"]
team_id(ENV["FASTLANE_TEAM_ID"]) if ENV["FASTLANE_TEAM_ID"]
itc_team_id(ENV["FASTLANE_ITC_TEAM_ID"]) if ENV["FASTLANE_ITC_TEAM_ID"]
